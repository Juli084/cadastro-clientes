# MongoDB em modo réplica (o Prisma exige). O docker-compose.yml da raiz sobe um.
DATABASE_URL=mongodb://localhost:27017/cadastro?directConnection=true
# Em desenvolvimento o Vite repassa /api para cá, então frontend e API ficam na mesma origem.
# Preencha só se o frontend for publicado em outro endereço (ex.: https://app.exemplo.com.br).
ORIGEM_DO_FRONTEND=
# O cookie de sessão só trafega por HTTPS. Use false apenas em desenvolvimento local.
COOKIE_SEGURO=false
# true quando a API roda atrás de um proxy reverso (Nginx, Caddy, Render...), para o
# limite de tentativas de login usar o IP real de quem acessa.
ATRAS_DE_PROXY=false
PORT=3333
